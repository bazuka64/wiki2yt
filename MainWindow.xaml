<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        >
    <Grid>
        <UniformGrid Columns="3" Rows="3" x:Name="grid">
            <Button FontSize="20" Content="Button 1" Click="Button_Click" Margin="5"/>
            <Button FontSize="20" Content="Button 2" Click="Button_Click" Margin="5"/>        
            <Button FontSize="20" Content="Button 3" Click="Button_Click" Margin="5"/>        
            <Button FontSize="20" Content="Button 4" Click="Button_Click" Margin="5"/>        
            <Button FontSize="20" Content="Button 5" Click="Button_Click" Margin="5"/>        
            <Button FontSize="20" Content="Button 6" Click="Button_Click" Margin="5"/>        
            <Button FontSize="20" Content="Button 7" Click="Button_Click" Margin="5"/>        
            <Button FontSize="20" Content="Button 8" Click="Button_Click" Margin="5"/>        
            <Button FontSize="20" Content="Button 9" Click="Button_Click" Margin="5"/>
        </UniformGrid>
    </Grid>
</Window>
